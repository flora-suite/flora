{
  "presets": [
    ["@babel/preset-env", { "targets": { "node": "22" } }],
    "@babel/preset-typescript",
    "@babel/preset-react"
  ],
  "plugins": [
    "babel-plugin-transform-import-meta",
    "@babel/plugin-transform-explicit-resource-management",
    ["@babel/plugin-proposal-decorators", { "version": "legacy" }]
  ]
}
