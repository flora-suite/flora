{
  "testMatch": ["<rootDir>/src/**/*.test.ts(x)?"],
  "transform": {
    "\\.[jt]sx?$": ["babel-jest", { "rootMode": "upward" }]
  },
  "transformIgnorePatterns": [],
  "moduleNameMapper": {
    "\\.svg$": "<rootDir>/../suite-base/src/test/mocks/MockSvg.tsx",
    "\\.(glb|md|png)$": "<rootDir>/../suite-base/src/test/mocks/fileMock.ts",
    "@lichtblick/suite-base/(.*)": "<rootDir>/../suite-base/src/$1"
  },
  "testEnvironment": "jsdom",
  "//": "Native find is slow because it does not exclude files: https://github.com/facebook/jest/pull/11264#issuecomment-825377579",
  "haste": { "forceNodeFilesystemAPI": true },
  "setupFilesAfterEnv": ["<rootDir>/src/test/setup.ts"]
}
